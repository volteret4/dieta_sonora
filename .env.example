# Copia a .env y rellena. También se puede editar desde el panel ⚙ de la web.
# Si usas SOPS, pon estas variables en .encrypted.env (no se sube al repo).

# Last.fm
LASTFM_API_KEY=
LASTFM_USERNAME=

# Radicale (CalDAV): calendario de lanzamientos (eventos) y de compras/escuchas (tareas)
RADICALE_URL=https://radicale.example.org/
RADICALE_USERNAME=
RADICALE_PW=
RADICALE_CALENDAR=
CALENDAR_TASKS=
RADICALE_CALENDAR_URL=https://radicale.example.org/usuario/uid-del-calendario/
RADICALE_TASKS_URL=https://radicale.example.org/usuario/uid-de-las-tareas/

# ── Discos al calendario (tools/add_release_calendar.py y tools/discos_escuchados_calendario.py)
# Dónde se escribe: radicale, google o radicale,google
CALENDAR_BACKENDS=radicale
# Tu feed de Muspy (muspy.com → Settings): los lanzamientos que van al calendario
MUSPY_FEED_URL=
# Radicale: calendario de lanzamientos y calendario con las tareas «Artista - Disco»
RELEASES_CALENDAR_NAME=discos
CALENDAR_NAME=
# Google: JSON de cuenta de servicio o de cliente OAuth «App de escritorio» (ruta relativa a tools/)
GOOGLE_CREDENTIALS_FILE=
# Calendario para los lanzamientos (python3 tools/calendario.py calendarios)
GOOGLE_CALENDAR_ID=
# Lista de Google Tasks con los discos pendientes (python3 tools/calendario.py listas); solo con OAuth
GOOGLE_TASKLIST_ID=
# Dónde se guarda el permiso de OAuth (relativo a tools/)
GOOGLE_TOKEN_FILE=google_token.json

# Airsonic / Navidrome (API Subsonic)
AIRSONIC_URL=
AIRSONIC_USER=
AIRSONIC_PASS=

# qBittorrent
QB_HOST=
QB_PORT=8080
QB_USER=
QB_PASS=

# Orpheus (opcional)
ORPHEUS_APIKEY=

# Avisos por Telegram (opcional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Rutas dentro del contenedor (los volúmenes se montan en docker-compose)
LIDARR_TORRENTS_PATH=/music/torrents_backup
LIDARR_WATCH_TORRENTS_PATH=/music/watch_torrents
MOODE_TEMP_PATH=/music/temp
TTS_WORK_DIR=/podcast-tts
ARTIST_SYNC_DB=/data/artist_sync.db

# Contraseña del panel ⚙ (vacía = sin contraseña)
SETTINGS_PASSWORD=

# ── docker-compose.yml ──────────────────────────────────────────
# Carpeta de torrents de Lidarr (con watch_torrents/ dentro)
LIDARR_TORRENTS=./datos/lidarr
# Carpeta donde llegan los discos descargados
DESCARGAS=./datos/descargas
# Opcional: carpeta con artist_sync.db de [artist-sync](https://github.com/volteret4/artist-sync)
ARTIST_SYNC_DIR=./datos/artist_sync
# Carpeta con lastfm_stats.db de [lastfm_scrobbles](https://github.com/volteret4/lastfm_scrobbles)
LASTFM_DIR=./datos/lastfm
# Uid:gid del usuario dueño de esta carpeta (los ficheros que se generan son suyos)
UID_GID=1000:1000
# Zona horaria de los trabajos programados (Ofelia)
TZ=Europe/Madrid
